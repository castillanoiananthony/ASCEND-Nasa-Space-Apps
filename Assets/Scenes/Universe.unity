  font: {fileID: 0}
  textScale: 1
  speakerName: Director Isabel Reyes
  welcomeEmail: 'Welcome to <b>ASCEND</b>, Mission Lead!


    We have three missions ready. Pick the one you want to lead.


    You can change your pick until you walk into the Meeting Room.


    - ASCEND Mission Control'
  lettersPerSecond: 45
