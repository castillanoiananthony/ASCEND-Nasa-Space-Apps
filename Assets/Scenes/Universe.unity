  - model: {fileID: 2242888416370347441, guid: 8861237438f5d063f9cdbb67e562bd91, type: 3}
    idle: {fileID: -6736537688726264772, guid: 8861237438f5d063f9cdbb67e562bd91, type: 3}
    talk: {fileID: -1208920132165896793, guid: 8861237438f5d063f9cdbb67e562bd91, type: 3}
