  launchPads:
  - id: pad.basic
    name: Basic Launch Mount
    description: Government-provided concrete pad with a hold-down clamp and a small umbilical mast. Fine for small launchers like Electron.
    source: 'Electron: 18 m tall, 1.2 m wide, ~13 t (Rocket Lab). Limits est.'
    useBuiltInModel: 1
    modelPrefab: {fileID: 0}
    image: {fileID: -6941893666776508460, guid: 975e18d1435cc8724a8bedb32515d1a1, type: 3}
    sceneObjectName: 
    costUSD: 0
    costEstimated: 0
    ownedFromStart: 1
    isTransporter: 0
    maxHeightM: 40
    maxWidthM: 6
    maxLiftoffMassT: 150
    requiresId: 
    ownMassT: 0
    carryCapacityT: 0
    rocketOffset: {x: 0, y: 0, z: 0}
  - id: pad.rail
    name: CanSat Launch Rail
    description: 6 m steel launch rail on a tripod, with a blast plate and a wired launch controller. Small sounding rockets slide up the rail until they are fast enough for their fins to keep them straight. Only for hobby / CanSat rockets.
    source: Typical high-power rocketry 1515 rail (~6 m), as used at CanSat competitions. Limits and cost est.
    useBuiltInModel: 1
    modelPrefab: {fileID: 0}
    image: {fileID: 0}
    sceneObjectName: 
    costUSD: 6000
    costEstimated: 1
    ownedFromStart: 0
    isTransporter: 0
    maxHeightM: 5
    maxWidthM: 0.3
    maxLiftoffMassT: 0.05
    requiresId: 
    ownMassT: 0
    carryCapacityT: 0
    rocketOffset: {x: 0, y: 0, z: 0}
  - id: pad.gantry
    name: Gantry Launch Pad
    description: Fixed pad with a service gantry tower, flame trench and propellant farm. The rocket is erected and serviced right at the pad. Medium rockets up to Falcon 9 class.
    source: 'Falcon 9: ~70 m tall, 3.7 m wide, ~550 t. Limits and cost est.'
    useBuiltInModel: 1
    modelPrefab: {fileID: 1580604851651097618, guid: 83a46f9236f254194b94cea9c51c8519, type: 3}
    image: {fileID: -4919171722757787144, guid: 3856d1d91a3a38ee29789496f9bcb958, type: 3}
    sceneObjectName: 
