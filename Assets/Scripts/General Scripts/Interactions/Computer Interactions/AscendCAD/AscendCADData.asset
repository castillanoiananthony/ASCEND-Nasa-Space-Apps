    carryCapacityT: 0
    rocketOffset: {x: 0, y: 0, z: 0}
  - id: pad.ml
    name: Mobile Launcher
    description: Two-story launch platform with a ~116 m umbilical tower. The rocket is stacked on it indoors, then the Crawler carries both to the pad. Built for super-heavy rockets.
    source: 'NASA: SLS Mobile Launcher tower ~116 m. Mass, limits and cost est.'
    useBuiltInModel: 1
    modelPrefab: {fileID: 8771091787928289351, guid: f38d3667358fc4d6b998fa0f4e127dcf, type: 3}
    image: {fileID: -852393517329727934, guid: 2d79cd3f3acb1b000bad5e520aa297e7, type: 3}
    sceneObjectName: 
    costUSD: 900000000
    costEstimated: 1
    ownedFromStart: 0
    isTransporter: 0
    maxHeightM: 125
    maxWidthM: 36
    maxLiftoffMassT: 3600
    requiresId: pad.crawler
    ownMassT: 5000
    carryCapacityT: 0
    rocketOffset: {x: 0, y: 7.6, z: 0}
  - id: pad.crawler
    name: Crawler-Transporter
    description: Tracked giant that carries the Mobile Launcher and its rocket to the pad at about 1.6 km/h. Required to use the Mobile Launcher.
    source: 'NASA: Crawler-Transporter 2 upgraded to ~8,165 t capacity. Cost est.'
    useBuiltInModel: 1
    modelPrefab: {fileID: -3822608229032858835, guid: 2ed86bb0e0beea58bb2edbbb4725cba0, type: 3}
